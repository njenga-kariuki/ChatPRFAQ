# Copy to backend/.env for local development. Every value is optional except the key
# (or LLM_PROVIDER=fake for an offline run).

ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic          # anthropic | fake
# FAKE_STREAM_DELAY_S=0.02      # >0 makes the fake provider stream at a human pace

# Models per tier (per-seat overrides: SEAT_4_MODEL, SEAT_1B_EFFORT, ...)
COUNCIL_MODEL_DEFAULT=claude-fable-5-1
COUNCIL_MODEL_FAST=claude-sonnet-5
COUNCIL_MODEL_REVIEWER=claude-opus-5
COUNCIL_EFFORT_DEFAULT=high
THINKING_DISPLAY=summarized     # summarized | omitted
ENABLE_FALLBACKS=true
WEB_SEARCH_MAX_USES=15
WEB_FETCH_MAX_USES=8

# Council behaviour
BAR_RAISER_ENABLED=true
PARALLEL_VALIDATION_PLAN=false
RUN_STEP_TIMEOUT_S=900
RUN_COST_CEILING_USD=12
MAX_SCHEMA_RETRIES=1

# Storage and web
DATABASE_URL=sqlite+aiosqlite:///./data/chatprfaq.db
# DATABASE_URL=postgresql+asyncpg://chatprfaq:chatprfaq@localhost:5432/chatprfaq
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
OWNER_TOKEN=
STATIC_DIR=../web/dist
PUBLIC_BASE_URL=http://localhost:8000
