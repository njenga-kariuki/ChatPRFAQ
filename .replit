modules = ["nodejs-22", "python-3.12"]

[nix]
channel = "stable-24_05"
packages = ["postgresql"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd web && npm ci && npm run build && cd ../backend && pip install ."]
run = ["sh", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"]

[workflows]
runButton = "Run ChatPRFAQ"

[[workflows.workflow]]
name = "Run ChatPRFAQ"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web && npm install && npm run build && cd ../backend && pip install -e . && uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[ports]]
localPort = 8000
externalPort = 80
